<?xml version="1.0" encoding="utf-8"?>
<!-- Widget colors — DARK appearance overrides (see values/widget_colors.xml).
     v1.0.5: the widget background stays PURE BLACK in Dark Mode (the
     user's request, same as iOS). Contrast: white on black = 21:1;
     accent #F2CD5C on black ≈ 12:1. -->
<resources>
    <color name="widget_bg_top">#000000</color>
    <color name="widget_bg_bottom">#000000</color>
    <color name="widget_stroke">#73F2CD5C</color>
    <color name="widget_primary">#FFFFFF</color>
    <color name="widget_secondary">#D9FFFFFF</color>
    <color name="widget_muted">#B8FFFFFF</color>
    <color name="widget_accent">#F2CD5C</color>
    <color name="widget_panel">#33FFFFFF</color>
</resources>
